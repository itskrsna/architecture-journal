# Copy this file to config/.env and fill in real values. Never commit config/.env.

# dev.to — Settings -> Account -> DEV API Keys
DEVTO_API_KEY=

# Mailbox used for sending review emails and reading your APPROVE/REJECT replies.
# Use an app password (Gmail: Google Account -> Security -> App passwords; requires 2FA on).
# Outlook/Office365 works too — adjust EMAIL_SMTP_HOST/EMAIL_IMAP_HOST accordingly.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_TO=

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
